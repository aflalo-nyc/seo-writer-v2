SHOPIFY_STORE=aflalo.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# ---- Optional ----
PORT=4000
# Public https address of this app once hosted. Required for Shopify webhooks (auto-generate on new styles).
PUBLIC_URL=
# Protect the app with a password once it is on the public internet. Leave blank while running on your laptop.
APP_PASSWORD=
# true = new photos are tagged and renamed automatically by the webhook. false = they wait in the Photos tab.
AUTO_APPLY_PHOTOS=true
GEN_WORKERS=4
CLAUDE_MODEL=claude-opus-5
CLAUDE_VISION_MODEL=claude-sonnet-5
